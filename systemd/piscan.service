[Unit]
Description=piscan barcode scanner
After=local-fs.target systemd-udev-settle.service

[Service]
Type=simple
User=piscan
Group=piscan
EnvironmentFile=-/etc/default/piscan
ExecStart=/usr/local/bin/piscan $PISCAN_ARGS
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
