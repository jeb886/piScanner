[Unit]
Description=piScanner barcode scanner
After=local-fs.target piscanner-gadget.service

[Service]
Type=simple
User=piscanner
Group=piscanner
EnvironmentFile=-/etc/default/piscanner
# Detach the text console from the SPI panel's framebuffer so getty/fbcon
# output (and the blinking cursor) can't overwrite the piScanner UI.
ExecStartPre=-/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*/bind; do echo 0 > "$v" 2>/dev/null; done'
ExecStart=/usr/local/bin/piscanner $PISCANNER_ARGS
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Writable tmpfs dir for --log-file (in-memory; survives until reboot).
RuntimeDirectory=piscanner

[Install]
WantedBy=multi-user.target
