[Unit]
Description=piScanner barcode scanner
After=local-fs.target piscanner-gadget.service

[Service]
Type=simple
User=piscanner
Group=piscanner
EnvironmentFile=-/etc/default/piscanner
# Keep the text console off the SPI panel's framebuffer. The primary
# mechanism is fbcon=vc:2-63 on the kernel cmdline (tty1 stays on the
# dummy console); this unbind is the fallback when that param is absent.
ExecStartPre=-+/bin/sh -c 'grep -q fbcon=vc: /proc/cmdline || for v in /sys/class/vtconsole/vtcon*/bind; do echo 0 > "$v" 2>/dev/null; done'
ExecStart=/usr/local/bin/piscanner $PISCANNER_ARGS
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Writable tmpfs dir for --log-file (in-memory; survives until reboot).
RuntimeDirectory=piscanner

[Install]
WantedBy=multi-user.target
